{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BritDocs",
  "version": "0.1.0",
  "identifier": "com.britdocs.word",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "BritDocs — Word Processor",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["britdoc"],
        "name": "BritDocs Document",
        "description": "BritDocs word processor document",
        "role": "Editor",
        "mimeType": "application/json"
      },
      {
        "ext": ["docx"],
        "name": "Word Document",
        "description": "Microsoft Word document (read-only import)",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      },
      {
        "ext": ["rtf"],
        "name": "Rich Text Format",
        "description": "Rich Text Format document (read-only import)",
        "role": "Editor",
        "mimeType": "application/rtf"
      }
    ]
  }
}